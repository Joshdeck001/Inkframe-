# Copy this file to .env.local (already gitignored) and fill in real values.
# .env.local is never committed — this .example file is the only one checked in.

# --- Supabase ---------------------------------------------------------------
# Project Settings → API in your Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key: server-only, NEVER exposed to the browser (no NEXT_PUBLIC_
# prefix). Used only in server routes/actions for privileged operations
# (e.g. the Admin Panel promoting a user, or a background job writing
# chapters/status on the user's behalf).
SUPABASE_SERVICE_ROLE_KEY=

# --- AI providers ------------------------------------------------------------
# Every AI call in the app (Writing Agent, Quality Loop, Cover, Metadata,
# Research, Advertising, the AI Copilot) tries these three in order — set
# whichever ones you have. Anthropic first, then OpenAI, then Gemini,
# automatically falling through if one is rate-limited, out of budget, or
# down, so the pipeline doesn't stop cold on a single vendor's outage. Only
# ONE key is actually required; set two or three for real redundancy. See
# lib/ai-client.ts.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Optional — override the OpenAI/Gemini model used when those providers are
# reached (Anthropic's model isn't configurable here since it's pinned to
# match InkFrame's own tool-calling requirements). Change these directly in
# Vercel's dashboard, no code edit needed, if either vendor renames or
# deprecates the default model this app ships with.
OPENAI_MODEL=
GEMINI_MODEL=

# Real cover-art generation (Cover Department) tries OpenAI, then Gemini —
# Claude has no image-generation capability at all, so it's never part of
# this fallback. Requires a billing-enabled account on at least one of the
# two: both providers' free tiers have a zero quota for image models. With
# neither key set, or neither succeeding, a concept just stays a
# text-only prompt (never a fabricated image) — exactly as before this
# feature existed. See lib/image-client.ts.
OPENAI_IMAGE_MODEL=
GEMINI_IMAGE_MODEL=

# --- Writing Agent (Step 6) --------------------------------------------------
# Any random string — protects /api/cron/writing-agent from being called by
# anyone but Vercel Cron. Set the SAME value in Vercel's project env vars.
# Vercel automatically sends it as `Authorization: Bearer $CRON_SECRET` on
# every cron invocation once this var exists in the project, so nothing else
# needs to be configured. For local testing:
#   curl -H "Authorization: Bearer <value>" http://localhost:3000/api/cron/writing-agent
CRON_SECRET=

# "free" or "pro" — controls how many chapters/units of work the
# background departments run per cron invocation (free: 1 pass, pro: up
# to 8). Change this directly in Vercel's dashboard (Settings ->
# Environment Variables) and click Redeploy — no code change needed.
# Defaults to "free" if unset. See lib/plan-tier.ts for exactly what this
# does and doesn't control (it does NOT change how often Vercel's cron
# fires — that's a platform-level setting, explained there).
PLAN_TIER=free
