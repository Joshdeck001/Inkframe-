# Copy this file to .env.local (already gitignored) and fill in real values.
# .env.local is never committed — this .example file is the only one checked in.

# --- Supabase ---------------------------------------------------------------
# Project Settings → API in your Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key: server-only, NEVER exposed to the browser (no NEXT_PUBLIC_
# prefix). Used only in server routes/actions for privileged operations
# (e.g. the Admin Panel promoting a user, or a background job writing
# chapters/status on the user's behalf).
SUPABASE_SERVICE_ROLE_KEY=

# --- AI providers ------------------------------------------------------------
# Anthropic — used for Book Blueprint generation (Step 5) and long-form
# chapter composition per the DK 2.0 model-routing rules.
ANTHROPIC_API_KEY=

# OpenAI / Gemini — wired in as the Writing Agent's model-routing options are
# implemented (Step 6+). Not required for Steps 1-5.
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- Writing Agent (Step 6) --------------------------------------------------
# Any random string — protects /api/cron/writing-agent from being called by
# anyone but Vercel Cron. Set the SAME value in Vercel's project env vars.
# Vercel automatically sends it as `Authorization: Bearer $CRON_SECRET` on
# every cron invocation once this var exists in the project, so nothing else
# needs to be configured. For local testing:
#   curl -H "Authorization: Bearer <value>" http://localhost:3000/api/cron/writing-agent
CRON_SECRET=
